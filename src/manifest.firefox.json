{
  "manifest_version": 2,
  "name": "better z.ai",
  "version": "1.4.0",
  "description": "A helper for z.ai: on send failures your message and attachments never get lost — automatic resend, preview control, draft guard, snippets, export and backup.",
  "browser_specific_settings": {
    "gecko": {
      "id": "better-zai@abdullayews",
      "strict_min_version": "112.0"
    }
  },
  "permissions": ["storage", "notifications", "unlimitedStorage", "clipboardWrite"],
  "background": { "scripts": ["background.js"] },
  "web_accessible_resources": ["inject.bundle.js"],
  "commands": {
    "retry-now": {
      "suggested_key": { "default": "Alt+R" },
      "description": "Resend the pending message immediately (Retry now)"
    },
    "toggle-pause": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Pause/resume automatic retries"
    },
    "export-chat": {
      "suggested_key": { "default": "Alt+E" },
      "description": "Export the current chat as Markdown (.md)"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "better z.ai",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.z.ai/*"],
      "js": [
        "ff-bootstrap.js",
        "core/classifier.js",
        "core/backoff.js",
        "core/defaults.js",
        "core/drafts.js",
        "core/preview.js",
        "core/popupcloser.js",
        "core/mdexport.js",
        "content.js"
      ],
      "css": ["pill.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
