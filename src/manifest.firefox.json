{
  "manifest_version": 2,
  "name": "Z.ai Auto-Resend",
  "version": "1.0.0",
  "description": "Sistem məşğul (system is busy) və digər xətalarda mesajı attachment-larla birlikdə avtomatik yenidən göndərir.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zai-autoresend@abdullayews",
      "strict_min_version": "112.0"
    }
  },
  "permissions": ["storage", "notifications", "unlimitedStorage"],
  "background": { "scripts": ["background.js"] },
  "web_accessible_resources": ["inject.bundle.js"],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "Z.ai Auto-Resend",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chat.z.ai/*"],
      "js": ["ff-bootstrap.js", "core/classifier.js", "core/backoff.js", "core/defaults.js", "content.js"],
      "css": ["pill.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
